PORT=3100
# CORS 허용 오리진 — 콤마로 여러 개. 예: https://dallyeori.com,https://duck.lingora.chat
CLIENT_ORIGIN=http://localhost:5173
# QR 스캔 시 열릴 프론트 URL (비우면 CLIENT_ORIGIN 첫 값)
QR_CLIENT_BASE_URL=

# Google/Kakao: redirect_uri는 요청 Host + X-Forwarded-Proto로 자동 생성
# (구글/카카오 콘솔에 사용 중인 도메인별 콜백 URL을 모두 등록해야 함)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

JWT_SECRET=
